+    def get_refiner_episode_metadata(self):
+        sim = self._env.sim
+        agent_state = sim.get_agent_state()
+        start_y = float(agent_state.position[1])
+        level_ranges = [
+            (
+                float(level.aabb.center[1] - level.aabb.sizes[1] / 2.0),
+                float(level.aabb.center[1] + level.aabb.sizes[1] / 2.0),
