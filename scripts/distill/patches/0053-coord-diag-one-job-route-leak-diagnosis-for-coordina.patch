diff --git a/scripts/submit/coord-diag.sh b/scripts/submit/coord-diag.sh
new file mode 100755
index 0000000..e91ddd2
--- /dev/null
+++ b/scripts/submit/coord-diag.sh
@@ -0,0 +1,187 @@
+#!/bin/bash
+#SBATCH --job-name=coord-diag
+#SBATCH --output=slurm-%x-%j.out
+#SBATCH --gpus=4
+#SBATCH -p vip_gpu_scze096
+#
+# ln01, one job: is the coordinate-fusion GT-legacy policy (SR ~85 on
+# val_unseen vs 68.41 for 18600 without coordinates) reading the route off
+# the map?  The legacy GT raster is a 7x7-cell corridor around the GT path,
+# so with map-frame node coordinates the corridor end is the goal.
+# Training-free, one checkpoint, every eval on all 4 GPUs, one after another:
+#
+#   own            the run's own map (reused from eval-iters.sh if present)
+#   occupancy      corridor geometry only, no semantics      (abl_occupancy_only)
+#   cross_scene    raster of another scene's episode         (abl_cross_scene_s0)
+#   cell_shuffle   semantics/counts kept, geometry destroyed (abl_cell_shuffle_s0)
+#   mentioned      only categories the instruction names     (mentioned_only)
+#   nomap          MODEL.MAP_ENCODER.enabled False
+#   coord_off      MODEL.MAP_ENCODER.coordinate_fusion False
+#
+# Reading: occupancy ~= own -> the policy follows corridor geometry (route
+# leak); cross_scene / cell_shuffle far below nomap -> it trusts the map's
+# geometry blindly; mentioned = what a perfect language-predicted map could
+# give this policy.
+#
+# Step 0 checks the own eval covers every val_unseen episode exactly once.
+# Step 1 derives the ablated namespaces on CPU (skipped when present; a
+# failed derivation drops only its eval).  Evals already done are skipped,
+# so resubmitting after a failure only runs what is missing.  The summary
+# (SR/SPL/OSR/nDTW/NE/PL, paired SR delta vs own with an 11-scene bootstrap
+# CI) goes to data/logs/checkpoints/<RUN>_diag_iter<ITER>/summary.md and the
+# end of the slurm log.
+#
+# Usage (from the repo root):
+#   sbatch scripts/submit/coord-diag.sh [RUN_NAME] [ITER]
+#   defaults: dagger_coordfusion_gt_legacy 16800
+# Env: VARIANTS (subset, space separated, default all of the above but own),
+#      NUM_ENVS (4 per rank).
+set -eo pipefail
+source /data/apps/miniforge3/etc/profile.d/conda.sh
+conda activate etpr1-uv || { echo "conda activate etpr1-uv failed" >&2; exit 2; }
+set -u
+
+RUN_NAME="${1:-dagger_coordfusion_gt_legacy}"
+ITER="${2:-16800}"
+SPLIT=val_unseen
+cd "${SLURM_SUBMIT_DIR:-$PWD}"
+[[ -f scripts/distill/eval_run.sh ]] || { echo "Submit from the repo root" >&2; exit 2; }
+grep -q EXTRA_ARGS scripts/distill/eval_run.sh || { echo "eval_run.sh lacks EXTRA_ARGS: apply patch 0053" >&2; exit 2; }
+RUN_DIR="data/logs/checkpoints/${RUN_NAME}"
+ARGS_FILE="${RUN_DIR}/eval_args.txt"
+[[ -f "${RUN_DIR}/ckpt.iter${ITER}.pth" ]] || { echo "Missing ${RUN_DIR}/ckpt.iter${ITER}.pth" >&2; exit 1; }
+[[ -f "${ARGS_FILE}" ]] || { echo "Missing ${ARGS_FILE}" >&2; exit 1; }
+arg_of() { awk -v k="$1" '$1 == k {print $2}' "${ARGS_FILE}" | tail -n 1; }
+NS="$(arg_of MODEL.MAP_ENCODER.cache_namespace)"
+PRETRAINED_CKPT="$(arg_of MODEL.pretrained_path)"
+[[ "$(arg_of MODEL.MAP_ENCODER.source)" == prior_gt && -n "${NS}" ]] \
+    || { echo "${RUN_NAME} is not a prior_gt run (eval_args.txt)" >&2; exit 1; }
+[[ -f "${PRETRAINED_CKPT}" ]] || { echo "pretrained_path not found: ${PRETRAINED_CKPT}" >&2; exit 1; }
+
+# Derived namespaces are written next to the source under data/cognitive_maps;
+# never into the partner's read-only checkout.
+CM_REAL="$(readlink -f data/cognitive_maps)"
+PARTNER_REAL="$(readlink -f "${HOME}/run/ETP-R1" || true)"
+if [[ -n "${PARTNER_REAL}" && -d "${PARTNER_REAL}" && "${CM_REAL}/" == "${PARTNER_REAL}/"* ]]; then
+    echo "data/cognitive_maps resolves into the partner repo (${CM_REAL}); refusing to write there" >&2; exit 1
+fi
+[[ -d "data/cognitive_maps/${NS}" ]] || { echo "Source namespace missing: data/cognitive_maps/${NS}" >&2; exit 1; }
+
+export REPO_ROOT="$PWD" PYTHON="$(command -v python)" TORCHRUN="$(command -v torchrun)"
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}" SPLIT
+OUT="data/logs/checkpoints/${RUN_NAME}_diag_iter${ITER}"
+mkdir -p "${OUT}"
+echo "job=${SLURM_JOB_ID:-none} node=$(hostname) gpus=${CUDA_VISIBLE_DEVICES} run=${RUN_NAME} iter=${ITER} ns=${NS} cognitive_maps=${CM_REAL}"
+
+result_dir() {  # suffix -> eval_results dir ("" = own)
+    echo "data/logs/checkpoints/${RUN_NAME}_eval_iter${ITER}_${SPLIT}${1:+_$1}/eval_results"
+}
+done_eval() { [[ -f "$(result_dir "$1")/stats_ckpt_${ITER}_${SPLIT}.json" ]]; }
+
+# ---- own -------------------------------------------------------------------
+if done_eval ""; then
+    echo "$(date -Is) own: reusing $(result_dir "")"
+else
+    echo "$(date -Is) own: start"
+    bash scripts/distill/eval_run.sh "${RUN_NAME}" "${ITER}" "${PRETRAINED_CKPT}"
+fi
+
+# ---- step 0: coverage of the own eval ----------------------------------------
+PYTHONPATH="$PWD" python - "$(result_dir "")" "${ITER}" "${SPLIT}" <<'PY' | tee "${OUT}/coverage.txt" || true
+import glob, gzip, json, sys
+from collections import Counter
+from prior import R2R_DIR
+d, it, split = sys.argv[1:]
+with gzip.open(R2R_DIR / split / f"{split}.json.gz", "rt") as f:
+    expected = {str(e["episode_id"]) for e in json.load(f)["episodes"]}
+files = sorted(glob.glob(f"{d}/stats_ep_ckpt_{it}_{split}_r*_w*.json"))
+ids = Counter()
+for p in files:
+    ids.update(str(k) for k in json.load(open(p)))
+dup = sum(c - 1 for c in ids.values() if c > 1)
+seen = set(ids)
+print(f"own eval coverage: rank files {len(files)}, episode entries {sum(ids.values())}, "
+      f"unique {len(seen)}, duplicated entries {dup}, expected {len(expected)}, "
+      f"missing {len(expected - seen)}, unexpected {len(seen - expected)}")
+m = json.load(open(f"{d}/stats_ckpt_{it}_{split}.json"))
+print("own aggregate: " + ", ".join(f"{k} {m[k]:.4f}" for k in ("success", "spl", "oracle_success", "distance_to_goal") if k in m))
+print("COVERAGE OK" if not dup and seen == expected else "COVERAGE PROBLEM: the own SR is not over the full split")
+PY
+[[ -s "${OUT}/coverage.txt" ]] || echo "coverage check could not run (see above); continuing"
+
+# ---- step 1: derived namespaces (CPU) ----------------------------------------
+declare -A VAR_ARGS
+derive() {  # variant, python args... ; prints nothing, fills VAR_ARGS on success
+    local variant="$1"; shift
+    local ns
+    if ns="$(PYTHONPATH="$PWD" python "$@" --namespace "${NS}" --split "${SPLIT}" 2>"${OUT}/derive_${variant}.err" | tail -n 1)" \
+        && [[ -d "data/cognitive_maps/${ns}" ]]; then
+        VAR_ARGS[${variant}]="MODEL.MAP_ENCODER.cache_namespace ${ns}"
+        echo "$(date -Is) namespace ${ns}: ready"
+    else
+        echo "$(date -Is) namespace for ${variant}: FAILED, see ${OUT}/derive_${variant}.err"
+    fi
+}
+derive occupancy    scripts/distill/make_ablated_gt_cache.py --mode occupancy_only
+derive cross_scene  scripts/distill/make_ablated_gt_cache.py --mode cross_scene --seed 0
+derive cell_shuffle scripts/distill/make_ablated_gt_cache.py --mode cell_shuffle --seed 0
+derive mentioned    scripts/distill/make_mentioned_only_gt_cache.py
+VAR_ARGS[nomap]="MODEL.MAP_ENCODER.enabled False"
+VAR_ARGS[coord_off]="MODEL.MAP_ENCODER.coordinate_fusion False"
+
+# ---- step 2: evals, one after another on all GPUs ------------------------------
+read -ra VARIANT_LIST <<< "${VARIANTS:-occupancy cross_scene nomap coord_off cell_shuffle mentioned}"
+failed=()
+for v in "${VARIANT_LIST[@]}"; do
+    if done_eval "${v}"; then echo "$(date -Is) ${v}: already evaluated"; continue; fi
+    if [[ -z "${VAR_ARGS[${v}]:-}" ]]; then echo "$(date -Is) ${v}: no namespace, skipped"; failed+=("${v}"); continue; fi
+    echo "$(date -Is) ${v}: start (${VAR_ARGS[${v}]})"
+    if EVAL_SUFFIX="${v}" EXTRA_ARGS="${VAR_ARGS[${v}]}" \
+        bash scripts/distill/eval_run.sh "${RUN_NAME}" "${ITER}" "${PRETRAINED_CKPT}" > "${OUT}/eval_${v}.log" 2>&1; then
+        echo "$(date -Is) ${v}: done"
+    else
+        echo "$(date -Is) ${v}: FAILED, see ${OUT}/eval_${v}.log"; failed+=("${v}")
+    fi
+done
+
+# ---- summary -------------------------------------------------------------------
+python - "$(result_dir "")" "${ITER}" "${SPLIT}" "${VARIANT_LIST[@]}" <<'PY' | tee "${OUT}/summary.md"
+import glob, json, subprocess, sys
+own, it, split, *variants = sys.argv[1:]
+base = own[: -len("/eval_results")]
+
+def stats(d):
+    p = f"{d}/stats_ckpt_{it}_{split}.json"
+    try:
+        return json.load(open(p))
+    except OSError:
+        return None
+
+def paired(d):
+    try:
+        out = subprocess.run([sys.executable, "scripts/distill/paired_analysis.py", "--dir-a", own,
+                              "--dir-b", d, "--split", split, "--reps", "5000"],
+                             capture_output=True, text=True, check=True).stdout
+    except subprocess.CalledProcessError:
+        return "n/a"
+    for line in out.splitlines():
+        if line.startswith("| SR "):
+            c = [x.strip() for x in line.strip("|").split("|")]
+            return f"{c[3]} {c[4]}"
+    return "n/a"
+
+print(f"| variant | SR | SPL | OSR | nDTW | NE | PL | OSR-SR | SR - own [95% CI] |")
+print("|---|---:|---:|---:|---:|---:|---:|---:|---|")
+for name, d in [("own", own)] + [(v, f"{base}_{v}/eval_results") for v in variants]:
+    m = stats(d)
+    if m is None:
+        print(f"| {name} | missing | | | | | | | |")
+        continue
+    ci = "" if name == "own" else paired(d)
+    print(f"| {name} | {m['success']*100:.2f} | {m['spl']*100:.2f} | {m['oracle_success']*100:.2f} | "
+          f"{m.get('ndtw', float('nan'))*100:.2f} | {m['distance_to_goal']:.2f} | {m.get('path_length', float('nan')):.1f} | "
+          f"{(m['oracle_success']-m['success'])*100:.2f} | {ci} |")
+PY
+cat "${OUT}/coverage.txt"
+echo "Summary: ${OUT}/summary.md"
+[[ ${#failed[@]} -eq 0 ]] || { echo "failed/skipped variants: ${failed[*]}" >&2; exit 1; }
