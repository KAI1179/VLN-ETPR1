+def gt_direction_turns(points, similarity_threshold: float) -> Tuple[int, int]:
+    """Turns along the dense GT path, with the rule that builds the cognitive
+    map's GT direction vectors (prior.cognitive_map_generation.
+    trajectory_direction_vectors): each non-zero GT segment's direction is
+    compared with the last kept direction, and a cosine below
+    similarity_threshold (TRAJECTORY_KEYPOINT_SIMILARITY_THRESHOLD = 0.8,
+    i.e. > 36.87 deg) keeps the new direction.  Unlike the map metadata there
+    is no cap of five, and triggers on consecutive segments (a turn spread over
+    several short GT steps) are merged into one turn.
+
+    Returns (turns after merging, raw direction changes)."""
+    from prior.directions import world_delta_to_direction_vector
+
+    kept = None
+    trigger_idx: List[int] = []
+    k = -1  # index among non-zero segments
+    for a, b in zip(points[:-1], points[1:]):
+        dx = float(b[0]) - float(a[0])
+        dz = float(b[2]) - float(a[2])
+        if dx == 0.0 and dz == 0.0:
+            continue
+        k += 1
+        d = world_delta_to_direction_vector(dx, dz)
+        if kept is None:
+            kept = d
+            continue
+        if d[0] * kept[0] + d[1] * kept[1] < similarity_threshold:
+            trigger_idx.append(k)
+            kept = d
+    turns = sum(1 for i, t in enumerate(trigger_idx) if i == 0 or t != trigger_idx[i - 1] + 1)
+    return turns, len(trigger_idx)
 
 
