From 56e29442461437479c42759f1a5f94f0e057422f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 25 Sep 2026 01:32:51 +0000
Subject: [PATCH] Eval launchers: free rendezvous port and EGL environment

torchrun --standalone on torch 2.1 binds port 29400, so concurrent evals
collided during R6. Pick a free port per launch (MASTER_PORT overrides)
and export the EGL vendor dir; eval_student_gt_full.sh also exports the
LD_PRELOAD that eval_s4.sh needs.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xm3S8jGTjU1YqXnUPuWMgH
---
 scripts/distill/eval_dagger_distill.sh      | 7 ++++++-
 scripts/distill/eval_run.sh                 | 7 ++++++-
 scripts/distill/eval_student_gt_full.sh     | 2 ++
 scripts/distill/eval_teacher_ablation.sh    | 7 ++++++-
 scripts/distill/eval_teacher_on_llm_maps.sh | 7 ++++++-
 scripts/refiner/eval_s4.sh                  | 7 ++++++-
 6 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/scripts/distill/eval_dagger_distill.sh b/scripts/distill/eval_dagger_distill.sh
index f0adad2..deeb882 100755
--- a/scripts/distill/eval_dagger_distill.sh
+++ b/scripts/distill/eval_dagger_distill.sh
@@ -13,6 +13,11 @@ set -euo pipefail
 REPO_ROOT="/home/xukai/code/ETP-R1-snapshot/ETP-R1"
 PYTHON="/home/xukai/anaconda3/envs/etpr1-py38/bin/python"
 TORCHRUN="/home/xukai/anaconda3/envs/etpr1-py38/bin/torchrun"
+# torchrun --standalone binds a fixed rendezvous port on torch 2.1, so concurrent
+# evals collide; pick a free port instead (override with MASTER_PORT).
+free_port() { "${PYTHON}" -c 'import socket; s=socket.socket(); s.bind(("localhost",0)); print(s.getsockname()[1]); s.close()'; }
+RDZV_PORT="${MASTER_PORT:-$(free_port)}"
+export __EGL_VENDOR_LIBRARY_DIRS="${__EGL_VENDOR_LIBRARY_DIRS:-/usr/share/glvnd/egl_vendor.d}"
 
 DRY_RUN_ARGS=()
 if [[ "${1:-}" == "--dry-run" ]]; then
@@ -54,7 +59,7 @@ if [[ ${#DRY_RUN_ARGS[@]} -eq 0 && ! -f "${CKPT_PATH}" ]]; then
 fi
 
 COMMAND=(
-    "${TORCHRUN}" --standalone --nproc_per_node="${GPU_NUMBERS}" "${REPO_ROOT}/run.py"
+    "${TORCHRUN}" --rdzv_backend=c10d --rdzv_endpoint="localhost:${RDZV_PORT}" --nproc_per_node="${GPU_NUMBERS}" "${REPO_ROOT}/run.py"
     --exp_name "${EVAL_NAME}"
     --run-type eval
     --exp-config "${REPO_ROOT}/run_r2r/iter_train.yaml"
