From 338c71144d43bd748702e5a2d43795dc63bf0d0c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 13:04:13 +0000
Subject: [PATCH] run_dagger_distill_legacy.sh: run on ln01 (slurm wrapper,
 auto paths)

REPO_ROOT defaults to the checkout the script lives in and TORCHRUN to the
torchrun on PATH, as run_dagger_coord_fusion.sh does; the teacher and the
460000 pretraining checkpoints are looked up in the known WZ and ln01
worktree locations, with GT_TEACHER_CKPT / PRETRAINED_CKPT as overrides and
a clear error naming the variable when neither exists. GPU detection
survives a node without nvidia-smi (dry run assumes 4 GPUs, a real run
exits with a message), same as patch 0038.

scripts/submit/dagger-distill-legacy.sh MODE: sbatch wrapper (4 GPUs,
vip_gpu_scze096, etpr1-uv), job-specific rendezvous port, environment
passed through, resume by re-submitting with the same RUN_NAME.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Q37SwHSfdSLWwALjMD6Pvv
---
 scripts/distill/run_dagger_distill_legacy.sh | 41 +++++++++++++++-----
 scripts/submit/dagger-distill-legacy.sh      | 41 ++++++++++++++++++++
 2 files changed, 72 insertions(+), 10 deletions(-)
 create mode 100755 scripts/submit/dagger-distill-legacy.sh

diff --git a/scripts/distill/run_dagger_distill_legacy.sh b/scripts/distill/run_dagger_distill_legacy.sh
index 3c3f725..03b6dfd 100755
--- a/scripts/distill/run_dagger_distill_legacy.sh
+++ b/scripts/distill/run_dagger_distill_legacy.sh
@@ -16,6 +16,13 @@
 # Resume: if data/logs/checkpoints/<RUN_NAME>/ckpt.iter*.pth exists the run
 # continues from the latest one; re-running after a crash is always safe.
 #
+# Runs on WZ (torchrun directly) and on ln01 (through
+# scripts/submit/dagger-distill-legacy.sh). REPO_ROOT defaults to the checkout
+# this script lives in and TORCHRUN to the torchrun on PATH; both can be set
+# in the environment. The teacher and pretraining checkpoints are looked up
+# in a few known locations (WZ, ln01 worktree); set GT_TEACHER_CKPT /
+# PRETRAINED_CKPT when they live elsewhere.
+#
 # Env overrides: RUN_NAME (dagger_distill_legacy18600_<MODE>), ITERS (20000),
 # NUM_ENVS (4 per process; batch_donor needs >= 2), PRETRAINED_CKPT (460000),
 # LOAD_MAP (False: map modules train from initialisation, as the teacher's
@@ -24,8 +31,9 @@
 # DISTILL_WEIGHT (1.0), CKPT_INTERVAL (1000), CUDA_VISIBLE_DEVICES, MASTER_PORT.
 set -euo pipefail
 
-REPO_ROOT="/home/xukai/code/ETP-R1-snapshot/ETP-R1"
-TORCHRUN="/home/xukai/anaconda3/envs/etpr1-py38/bin/torchrun"
+REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
+TORCHRUN="${TORCHRUN:-$(command -v torchrun || true)}"
+[[ -x "${TORCHRUN}" ]] || { echo "torchrun not found: activate the training env or set TORCHRUN" >&2; exit 1; }
 
 MODE="${1:-}"
 case "${MODE}" in
@@ -44,12 +52,17 @@ elif [[ $# -gt 1 ]]; then
 fi
 
 if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
-    _n="$(nvidia-smi -L 2>/dev/null | wc -l | tr -d ' ')"
-    if [[ "${_n}" -gt 0 ]]; then
-        CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((_n - 1)))"
-    else
-        CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
+    # A node without nvidia-smi (ln01 login node) must not kill the script
+    # under pipefail: count what is there, and for a dry run assume 4 GPUs.
+    _n="$( (nvidia-smi -L 2>/dev/null || true) | wc -l | tr -d ' ')"
+    if [[ "${_n}" -eq 0 ]]; then
+        if [[ ${#DRY_RUN_ARGS[@]} -ne 0 ]]; then
+            _n=4; echo "No GPU visible here; dry run assumes ${_n} GPUs"
+        else
+            echo "No GPU visible and CUDA_VISIBLE_DEVICES unset (submit through slurm or set it)" >&2; exit 1
+        fi
     fi
+    CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((_n - 1)))"
 fi
 IFS=',' read -ra _gpu_list <<< "${CUDA_VISIBLE_DEVICES}"
 GPU_NUMBERS="${#_gpu_list[@]}"
@@ -59,8 +72,15 @@ NUM_ENVS="${NUM_ENVS:-4}"
 RUN_NAME="${RUN_NAME:-dagger_distill_legacy18600_${MODE}}"
 RUN_DIR="${REPO_ROOT}/data/logs/checkpoints/${RUN_NAME}"
 LOG_PATH="${RUN_DIR}/train.log"
-PRETRAINED_CKPT="${PRETRAINED_CKPT:-/home/xukai/code/ETP-R1-snapshot/checkpoints/llm-grid-try5-r1p5/model_step_460000.pt}"
-GT_TEACHER_CKPT="${GT_TEACHER_CKPT:-/data/xukai/etp-r1-snapshot/checkpoints/priorgt-nogaussian-18600-20260929/ckpt.iter18600.pth}"
+# First existing candidate wins; the first entry doubles as the error text.
+_pick() { local _v; for _v in "$@"; do [[ -f "${_v}" ]] && { echo "${_v}"; return; }; done; echo "$1"; }
+PRETRAINED_CKPT="${PRETRAINED_CKPT:-$(_pick \
+    "${REPO_ROOT}/pretrained/r2r_rxr_ce/llm_grid_try5/ckpts/model_step_460000.pt" \
+    "/home/xukai/code/ETP-R1-snapshot/checkpoints/llm-grid-try5-r1p5/model_step_460000.pt")}"
+GT_TEACHER_CKPT="${GT_TEACHER_CKPT:-$(_pick \
+    "/data/xukai/etp-r1-snapshot/checkpoints/priorgt-nogaussian-18600-20260929/ckpt.iter18600.pth" \
+    "${REPO_ROOT}/data/logs/checkpoints/priorgt-nogaussian-18600-20260929/ckpt.iter18600.pth" \
+    "${REPO_ROOT}/data/logs/checkpoints/priorgt_nogaussian_dagger_440k/ckpt.iter18600.pth")}"
 GT_TEACHER_NAMESPACE="gt.legacy.r1p5.direction5.v1"
 GT_TEACHER_POLICY_NAME="PriorGTTry5Policy"
 LOAD_MAP="${LOAD_MAP:-False}"
@@ -115,7 +135,8 @@ for key in distill_stop_factorized effect_match_weight gate_enabled; do
         exit 2
     fi
 done
-[[ -f "${GT_TEACHER_CKPT}" ]] || { echo "Teacher checkpoint not found: ${GT_TEACHER_CKPT}" >&2; exit 1; }
+[[ -f "${PRETRAINED_CKPT}" ]] || { echo "Pretraining checkpoint not found: ${PRETRAINED_CKPT} (set PRETRAINED_CKPT)" >&2; exit 1; }
+[[ -f "${GT_TEACHER_CKPT}" ]] || { echo "Teacher checkpoint not found: ${GT_TEACHER_CKPT} (set GT_TEACHER_CKPT to the GT-legacy ckpt.iter18600.pth)" >&2; exit 1; }
 [[ -d "${REPO_ROOT}/data/cognitive_maps/${GT_TEACHER_NAMESPACE}/raster" ]] \
     || { echo "Teacher namespace not found: ${REPO_ROOT}/data/cognitive_maps/${GT_TEACHER_NAMESPACE}/raster" >&2; exit 1; }
 
diff --git a/scripts/submit/dagger-distill-legacy.sh b/scripts/submit/dagger-distill-legacy.sh
new file mode 100755
index 0000000..1c19f0c
--- /dev/null
+++ b/scripts/submit/dagger-distill-legacy.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+#SBATCH --job-name=dagger-distill-legacy
+#SBATCH --output=slurm-%x-%j.out
+#SBATCH --gpus=4
+#SBATCH -p vip_gpu_scze096
+#
+# ln01 (slurm) wrapper for scripts/distill/run_dagger_distill_legacy.sh:
+# GT-legacy 18600 teacher distilled into an isomorphic LLM-Grid try5 student.
+#
+# Usage (from the exp/refiner worktree root, patch 0050 applied):
+#   sbatch --job-name=distill-kl    scripts/submit/dagger-distill-legacy.sh kl
+#   sbatch --job-name=distill-gated scripts/submit/dagger-distill-legacy.sh gated
+#   sbatch --job-name=distill-full  scripts/submit/dagger-distill-legacy.sh full
+#
+# sbatch exports the submitting shell's environment, so GT_TEACHER_CKPT,
+# PRETRAINED_CKPT, RUN_NAME, NUM_ENVS, ITERS, CKPT_INTERVAL, EFFECT_WEIGHT,
+# GATE_TAU, GATE_MIN, STOP_WEIGHT and MASTER_PORT all pass through to the
+# launcher. One rank per allocated GPU; CUDA_VISIBLE_DEVICES is set by slurm.
+# Re-submitting with the same RUN_NAME resumes from the latest ckpt.iter*.pth
+# in the run directory (the launcher's own rule).
+#
+# The env's conda activate.d hooks read unset variables, so turn on nounset only afterwards.
+set -eo pipefail
+source /data/apps/miniforge3/etc/profile.d/conda.sh
+conda activate etpr1-uv || { echo "conda activate etpr1-uv failed" >&2; exit 2; }
+set -u
+
+[[ $# -eq 1 ]] || { echo "Usage: sbatch scripts/submit/dagger-distill-legacy.sh {kl|gated|full}" >&2; exit 2; }
+MODE="$1"
+
+cd "${SLURM_SUBMIT_DIR:-$PWD}"
+[[ -f scripts/distill/run_dagger_distill_legacy.sh ]] || { echo "Submit from the repo root (no scripts/distill/run_dagger_distill_legacy.sh here)" >&2; exit 2; }
+
+# Two jobs on one node must not share a rendezvous port.
+export MASTER_PORT="${MASTER_PORT:-$((29500 + SLURM_JOB_ID % 1000))}"
+export REPO_ROOT="$PWD"
+
+echo "job=${SLURM_JOB_ID} node=$(hostname) gpus=${CUDA_VISIBLE_DEVICES:-unset} mode=${MODE} port=${MASTER_PORT}"
+nvidia-smi --query-gpu=index,name,memory.used --format=csv,noheader || true
+
+bash scripts/distill/run_dagger_distill_legacy.sh "${MODE}"
