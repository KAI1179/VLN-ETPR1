From 1e8c8c692440ceba0e80c855ef659296ac8e715b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 02:07:13 +0000
Subject: [PATCH] One-job evaluation of several fixed-tokenizer DAgger
 checkpoints

scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh [ITER ...] evaluates each
checkpoint on R2R val_unseen with the llm_grid_try5_fixedtok_eval_dagger mode
(all GPUs of the job, sequentially), takes pretrained_path from the run's
config.yaml, skips iterations that already have a stats file, and ends with
summarize_eval.py written to eval_summary.md.
---
 .../llm-grid-try5-fixedtok-eval-iters.sh      | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)
 create mode 100755 scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh

diff --git a/scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh b/scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh
new file mode 100755
index 0000000..3d14976
--- /dev/null
+++ b/scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh
@@ -0,0 +1,72 @@
+#!/bin/bash
+#SBATCH --job-name=llm-grid-try5-fixedtok-eval
+#SBATCH --output=slurm-%x-%j.out
+#SBATCH --gpus=4
+#SBATCH -p vip_gpu_scze096
+# Evaluate several checkpoints of the fixed-tokenizer DAgger run on R2R
+# val_unseen inside one job: sequentially, each evaluation using all GPUs of
+# the job (the llm_grid_try5_fixedtok_eval_dagger mode), then print the
+# summary table.
+#
+# Usage: sbatch scripts/submit/llm-grid-try5-fixedtok-eval-iters.sh [ITER ...]
+#   Default ITER list: 10000 12000 ... 30000. Submit from the repo root.
+# Env: RUN_NAME (release_r2r_llm_grid_try5_fixedtok_dagger).
+# Results: data/logs/checkpoints/<RUN_NAME>/eval_results/stats_ckpt_<ITER>_val_unseen.json
+#   (summarize_eval.py / paired_analysis.py --dir-a layout). The trainer
+#   overwrites an existing stats file when EVAL.CKPT_PATH_DIR names a file, so
+#   iterations that already have one are skipped here.
+# Summary: data/logs/checkpoints/<RUN_NAME>/eval_summary.md
+# The env's conda activate.d hooks read unset variables, so turn on nounset only afterwards.
+eval "$(conda shell.bash hook)" && conda activate etpr1-uv || { echo "conda activate etpr1-uv failed" >&2; exit 2; }
+set -euo pipefail
+
+RUN_NAME="${RUN_NAME:-release_r2r_llm_grid_try5_fixedtok_dagger}"
+RUN_DIR="data/logs/checkpoints/${RUN_NAME}"
+[[ -d "${RUN_DIR}" ]] || { echo "run directory not found: ${RUN_DIR} (submit from the repo root)" >&2; exit 2; }
+if [[ $# -gt 0 ]]; then
+    ITERS=("$@")
+else
+    ITERS=(10000 12000 14000 16000 18000 20000 22000 24000 26000 28000 30000)
+fi
+for it in "${ITERS[@]}"; do
+    [[ "${it}" =~ ^[0-9]+$ ]] || { echo "ITER must be an integer, got '${it}'" >&2; exit 2; }
+done
+
+# The eval mode rebuilds the policy from MODEL.pretrained_path (and loads its
+# map modules) before loading the DAgger checkpoint; use the same file the
+# training run used instead of the launcher's default.
+PRETRAINED="$(grep -E '^\s*pretrained_path:' "${RUN_DIR}/config.yaml" | head -1 | awk '{print $2}' | tr -d "'\"")"
+[[ -f "${PRETRAINED}" ]] || { echo "pretrained_path from ${RUN_DIR}/config.yaml not found: '${PRETRAINED}'" >&2; exit 2; }
+export LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT="${PRETRAINED}"
+echo "run=${RUN_NAME} pretrained=${PRETRAINED} iters=${ITERS[*]}"
+
+failed=()
+for it in "${ITERS[@]}"; do
+    ckpt="${RUN_DIR}/ckpt.iter${it}.pth"
+    stats="${RUN_DIR}/eval_results/stats_ckpt_${it}_val_unseen.json"
+    if [[ ! -f "${ckpt}" ]]; then
+        echo "iter ${it}: checkpoint missing (${ckpt}), skipped"
+        failed+=("${it}")
+        continue
+    fi
+    if [[ -f "${stats}" ]]; then
+        echo "iter ${it}: result exists, skipped"
+        continue
+    fi
+    echo "iter ${it}: start $(date -Is)"
+    if LLM_GRID_TRY5_FIXEDTOK_DAGGER_CKPT="${ckpt}" bash run_r2r/main_server.bash llm_grid_try5_fixedtok_eval_dagger \
+        && [[ -f "${stats}" ]]; then
+        echo "iter ${it}: done  $(date -Is)"
+    else
+        echo "iter ${it}: FAILED (no ${stats})"
+        failed+=("${it}")
+    fi
+done
+
+python scripts/distill/summarize_eval.py \
+    --run-name "${RUN_NAME}" --glob "${RUN_DIR}/eval_results/stats_ckpt_*_val_unseen.json" \
+    --markdown-out "${RUN_DIR}/eval_summary.md"
+if [[ ${#failed[@]} -gt 0 ]]; then
+    echo "iters without results: ${failed[*]}" >&2
+    exit 1
+fi
