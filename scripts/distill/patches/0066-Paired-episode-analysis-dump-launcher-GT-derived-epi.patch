+#!/usr/bin/env bash
+# Evaluate one checkpoint on R2R val_unseen with the per-step decision dump
+# (EVAL.decision_dump), in one of two protocols:
+#   free    the policy drives (protocol 1): normal evaluation + dump;
+#   forced  the DAgger expert drives (protocol 2): every policy sees the same
+#           states, the dump records what each would have chosen.
+#
+# Usage: bash scripts/analysis/dump_eval.sh MODEL PROTOCOL RUN_NAME ITER
+#   MODEL     baseline  mapless ETP-R1 (TRAINER SS-ETP-R1); the checkpoint is
+#                       CKPT (default: the release_r2r_dagger iter25000 path
+#                       below), RUN_NAME/ITER only name the output;
+#             try5      LLM-grid try5 DAgger run (same arguments as
+#                       scripts/distill/eval_run.sh, reads the run's
+#                       eval_args.txt when present);
+#             kd        dual-distillation student, same as try5 plus
+#                       MODEL.MAP_ENCODER.map_ablation ${MAP_VIEW:-none}
+#                       (none = map view, metadata_only = deployment view).
+# Env: CUDA_VISIBLE_DEVICES (default 0; several ids = several ranks),
+#      NUM_ENVS (4), BACK_ALGO (control), SPLIT (val_unseen), MASTER_PORT,
+#      PRETRAINED_CKPT (shapes only), ELEVATION_AXIS (y), CKPT (baseline),
+#      MAP_VIEW (kd), REPO_ROOT, PYTHON, TORCHRUN.
+# Output: data/logs/checkpoints/<RUN_NAME>_dump_<PROTOCOL>_iter<ITER>_<SPLIT>/eval_results/
+#   stats_ckpt_<ITER>_<SPLIT>.json        aggregate metrics (free protocol)
+#   stats_ep_ckpt_<ITER>_<SPLIT>_r*_w*.json per-episode metrics
+#   decisions_<SPLIT>_r*_w*.jsonl          per-step decisions (one file per rank)
+# Then: python scripts/analysis/episode_features.py --split val_unseen
+#       python scripts/analysis/paired_report.py --help
+set -euo pipefail
+
+REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
+PYTHON="${PYTHON:-$(command -v python)}"
+TORCHRUN="${TORCHRUN:-$(dirname "${PYTHON}")/torchrun}"
+free_port() { "${PYTHON}" -c 'import socket; s=socket.socket(); s.bind(("localhost",0)); print(s.getsockname()[1]); s.close()'; }
+RDZV_PORT="${MASTER_PORT:-$(free_port)}"
+export __EGL_VENDOR_LIBRARY_DIRS="${__EGL_VENDOR_LIBRARY_DIRS:-/usr/share/glvnd/egl_vendor.d}"
+
+if [[ $# -ne 4 ]]; then
+    echo "Usage: bash scripts/analysis/dump_eval.sh MODEL(baseline|try5|kd) PROTOCOL(free|forced) RUN_NAME ITER" >&2
+    exit 2
+fi
+MODEL="$1"; PROTOCOL="$2"; RUN_NAME="$3"; ITER="$4"
+case "${PROTOCOL}" in free) FORCING=False ;; forced) FORCING=True ;; *)
+    echo "PROTOCOL must be free or forced, got '${PROTOCOL}'" >&2; exit 2 ;; esac
+
+CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
+IFS=',' read -ra _gpu_list <<< "${CUDA_VISIBLE_DEVICES}"
+GPU_NUMBERS="${#_gpu_list[@]}"
+GPU_IDS="[$(seq -s, 0 $((GPU_NUMBERS - 1)))]"
+NUM_ENVS="${NUM_ENVS:-4}"
+BACK_ALGO="${BACK_ALGO:-control}"
+SPLIT="${SPLIT:-val_unseen}"
+RUN_DIR="${REPO_ROOT}/data/logs/checkpoints/${RUN_NAME}"
+EVAL_NAME="${RUN_NAME}_dump_${PROTOCOL}_iter${ITER}_${SPLIT}"
+EVAL_LOG="${REPO_ROOT}/data/logs/checkpoints/${EVAL_NAME}.log"
+RESULT_DIR="${REPO_ROOT}/data/logs/checkpoints/${EVAL_NAME}/eval_results"
+
+MODEL_ARGS=()
+case "${MODEL}" in
+    baseline)
+        CKPT_PATH="${CKPT:-/data/xukai/etp-r1-prior/logs/checkpoints/release_r2r_dagger/store/ckpt.iter25000.pth}"
+        PRETRAINED_CKPT="${PRETRAINED_CKPT:-${REPO_ROOT}/pretrained/r2r_rxr_ce/baseline/store2/model_step_367500.pt}"
+        MODEL_ARGS=(TRAINER_NAME SS-ETP-R1 MODEL.pretrained_path "${PRETRAINED_CKPT}")
+        ;;
+    try5|kd)
+        CKPT_PATH="${CKPT:-${RUN_DIR}/ckpt.iter${ITER}.pth}"
+        PRETRAINED_CKPT="${PRETRAINED_CKPT:-/home/xukai/code/ETP-R1-snapshot/checkpoints/llm-grid-try5-r1p5/model_step_460000.pt}"
+        MODEL_ARGS=(
+            TRAINER_NAME SS-ETP-LLM
+            MODEL.policy_name LLMGridTry5Policy
+            MODEL.MAP_ENCODER.enabled True
+            MODEL.MAP_ENCODER.architecture try5
+            MODEL.MAP_ENCODER.source llm_grid
+            MODEL.MAP_ENCODER.llm_cache_model_key llm-grid-r2r-rxr-r1p5-direction5-s2-tagfree
+            MODEL.MAP_ENCODER.refiner_ckpt ""
+            MODEL.MAP_ENCODER.load_pretrained_map_modules False
+            MODEL.elevation_axis "${ELEVATION_AXIS:-y}"
+            MODEL.pretrained_path "${PRETRAINED_CKPT}"
+        )
+        if [[ "${MODEL}" == "kd" ]]; then
+            MODEL_ARGS+=(MODEL.MAP_ENCODER.eval_map_source p0 MODEL.MAP_ENCODER.map_ablation "${MAP_VIEW:-none}")
+        fi
+        # Runs started by run_dagger_coord_fusion.sh record the model/map
+        # options their checkpoints need; they override the defaults above.
+        if [[ -f "${RUN_DIR}/eval_args.txt" ]]; then
+            while read -r key value; do MODEL_ARGS+=("${key}" "${value}"); done < "${RUN_DIR}/eval_args.txt"
+            echo "Using ${RUN_DIR}/eval_args.txt"
+        fi
+        ;;
+    *) echo "MODEL must be baseline, try5 or kd, got '${MODEL}'" >&2; exit 2 ;;
+esac
+[[ -f "${CKPT_PATH}" ]] || { echo "Checkpoint not found: ${CKPT_PATH}" >&2; exit 1; }
+[[ -f "${PRETRAINED_CKPT}" ]] || { echo "Pretrained checkpoint not found: ${PRETRAINED_CKPT}" >&2; exit 1; }
+if ls "${RESULT_DIR}"/decisions_"${SPLIT}"_r*.jsonl >/dev/null 2>&1; then
+    echo "Dump exists in ${RESULT_DIR}; delete it to redo." >&2; exit 1
+fi
+
+cd "${REPO_ROOT}"
+echo "model=${MODEL} protocol=${PROTOCOL} ckpt=${CKPT_PATH} gpus=${CUDA_VISIBLE_DEVICES} -> ${RESULT_DIR}"
+env CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES}" GLOG_minloglevel=2 MAGNUM_LOG=quiet \
+    PYTHONPATH="${REPO_ROOT}" "${TORCHRUN}" --rdzv_backend=c10d --rdzv_endpoint="localhost:${RDZV_PORT}" --nproc_per_node="${GPU_NUMBERS}" \
+    "${REPO_ROOT}/run.py" \
+    --exp_name "${EVAL_NAME}" \
+    --run-type eval \
+    --exp-config "${REPO_ROOT}/run_r2r/iter_train.yaml" \
+    SIMULATOR_GPU_IDS "${GPU_IDS}" TORCH_GPU_IDS "${GPU_IDS}" GPU_NUMBERS "${GPU_NUMBERS}" \
+    TASK_CONFIG.SEED 100 \
+    TASK_CONFIG.SIMULATOR.HABITAT_SIM_V0.ALLOW_SLIDING True \
+    NUM_ENVIRONMENTS "${NUM_ENVS}" \
+    EVAL.SPLIT "${SPLIT}" EVAL.EPISODE_COUNT -1 \
+    EVAL.CKPT_PATH_DIR "${CKPT_PATH}" \
+    EVAL.decision_dump True EVAL.teacher_forcing "${FORCING}" \
+    IL.back_algo "${BACK_ALGO}" \
+    "${MODEL_ARGS[@]}" 2>&1 | tee "${EVAL_LOG}"
+
+"${PYTHON}" - "${RESULT_DIR}" "${SPLIT}" <<'PY'
+import glob, json, os, sys
+d, split = sys.argv[1:3]
+files = sorted(glob.glob(os.path.join(d, f"decisions_{split}_r*.jsonl")))
+steps = eps = 0
+for f in files:
+    for line in open(f):
+        k = json.loads(line)["kind"]
+        steps += k == "step"; eps += k == "episode"
+print(f"\ndump: {len(files)} file(s), {eps} episodes, {steps} steps in {d}")
+PY
diff --git a/scripts/analysis/episode_features.py b/scripts/analysis/episode_features.py
new file mode 100644
index 0000000..d8e6aa8
--- /dev/null
+++ b/scripts/analysis/episode_features.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""Per-episode difficulty features for the paired-episode analysis.
+
+Everything is derived from the ground-truth path, the scene structure and the
+instruction -- never from a policy -- so the same strata apply to every model.
+For R2R <split> the script writes <out> (JSON: episode id -> features):
+
+  path_len_m        length of the GT trajectory (metres)
+  n_gt_points       number of GT trajectory points
+  n_room_changes    region (room) boundary crossings along the GT path, from
+                    the MP3D region boxes of the level the path starts on
+  n_rooms           distinct regions the GT path passes through
+  n_forks_graph     decision points along the GT path on the MP3D connectivity
+                    graph: visited nodes with >= 2 unobstructed onward
+                    neighbours (the one we came from excluded)
+  n_forks3_graph    the same with >= 3 onward neighbours
+  n_landmarks       object categories the instruction mentions (prior's
+                    extract_categories: name match + CLIP/spacy nouns)
+  n_room_words      region categories the instruction mentions
+  n_landmark_instances
+                    instances of the mentioned object categories within
+                    --decoy-radius of the GT path
+  n_decoys          those instances beyond the first per category, i.e. same-
+                    category objects that could be mistaken for the landmark
+  n_spatial_words   directional / ordinal words in the instruction
+  llm_region_hit    fraction of GT points on a cell the episode's LLM map
+                    labels with any region (check_map_frame's number), or null
+                    when the LLM cache has no map for the episode
+
+Example:
+    python scripts/analysis/episode_features.py --split val_unseen \
+        --out data/logs/analysis/features_val_unseen.json
+The LLM-map column needs the LLM navigation cache (--llm-model-key); pass
+--no-llm to skip it, --no-categories to skip the CLIP/spacy instruction pass
+(n_landmarks, n_decoys and n_room_words are then null).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import re
+from pathlib import Path
+from typing import Dict, List, Optional, Sequence, Tuple
+
+import numpy as np
+from tap import Tap
+
+from prior.bbox._geometry import _is_position_in_level, _point_to_obb_distance
+from prior.bbox._relevance import _first_touched_level_points, _local_point
+from prior.bbox._types import SceneSemanticBoxes
+from prior.etp_r1 import ConnectivityEntry
+from prior.vlnce import VLNCEEpisodeEntry
+
+SPATIAL_WORDS = re.compile(
+    r"\b(left|right|turn|straight|ahead|forward|past|through|around|behind|"
+    r"across|along|towards?|toward|into|out of|up|down|first|second|third|"
+    r"next|last|end of|corner|opposite|between|beside|next to|front of|"
+    r"back|u-turn|veer|bear|cross)\b",
+    re.IGNORECASE,
+)
+
+
+class Args(Tap):
+    split: str = "val_unseen"
+    out: str = "data/logs/analysis/features_val_unseen.json"
+    decoy_radius: float = 5.0
+    """Metres from the GT path within which a same-category object counts."""
+    snap_radius: float = 1.5
+    """Metres: a GT point is on a connectivity node if within this distance."""
+    llm_model_key: str = "llm-grid-r2r-rxr-r1p5-direction5-s2-tagfree"
+    meters_per_unit: float = 1.0
+    """MAP_ENCODER.start_position_meters_per_unit of the LLM cache."""
+    no_llm: bool = False
+    no_categories: bool = False
+    limit: int = 0
+    """Episodes to process; 0 = all."""
+
+
+def path_length(points: Sequence[Sequence[float]]) -> float:
+    p = np.asarray(points, dtype=float)
+    if len(p) < 2:
+        return 0.0
+    return float(np.linalg.norm(p[1:] - p[:-1], axis=1).sum())
+
+
+def region_sequence(level, level_points) -> List[Optional[Tuple[int, int]]]:
+    """Smallest region box containing each 2D point, as (category, index)."""
+    out = []
+    for x, z in level_points:
+        best = None
+        best_area = math.inf
+        for cat, boxes in enumerate(level.regions):
+            for j, box in enumerate(boxes):
+                if box.min[0] <= x <= box.max[0] and box.min[1] <= z <= box.max[1]:
+                    area = (box.max[0] - box.min[0]) * (box.max[1] - box.min[1])
+                    if area < best_area:
+                        best, best_area = (cat, j), area
+        out.append(best)
+    return out
+
+
+def room_stats(level, level_points) -> Tuple[int, int]:
+    seq = [r for r in region_sequence(level, level_points) if r is not None]
+    changes = sum(1 for a, b in zip(seq, seq[1:]) if a != b)
+    return changes, len(set(seq))
+
+
+def fork_stats(scene_id: str, gt_points, snap_radius: float) -> Tuple[int, int]:
+    try:
+        conn = ConnectivityEntry.map_for(scene_id)
+    except FileNotFoundError:
+        return -1, -1
+    all_ids = list(conn.keys())  # file order = index order of `unobstructed`
+    ids = [k for k in all_ids if conn[k].included]
+    pos = np.array([conn[k].position for k in ids], dtype=float)
+    visited: List[str] = []
+    for p in np.asarray(gt_points, dtype=float):
+        d = np.linalg.norm(pos - p, axis=1)
+        j = int(np.argmin(d))
+        if d[j] <= snap_radius and (not visited or visited[-1] != ids[j]):
+            visited.append(ids[j])
+    forks = forks3 = 0
+    for i, node in enumerate(visited[:-1]):
+        prev = visited[i - 1] if i > 0 else None
+        onward = [
+            all_ids[j]
+            for j, ok in enumerate(conn[node].unobstructed)
+            if ok and j < len(all_ids) and conn[all_ids[j]].included
+            and all_ids[j] != node and all_ids[j] != prev
+        ]
+        forks += len(onward) >= 2
+        forks3 += len(onward) >= 3
+    return forks, forks3
+
+
+def landmark_stats(level, level_points, mentioned_objects, decoy_radius: float) -> Tuple[int, int]:
+    instances = decoys = 0
+    for cat in mentioned_objects:
+        if cat >= len(level.objects):
+            continue
+        near = [
+            box
+            for box in level.objects[cat]
+            if any(_point_to_obb_distance(pt, box) <= decoy_radius for pt in level_points)
+        ]
+        instances += len(near)
+        decoys += max(0, len(near) - 1)
+    return instances, decoys
+
+
+def llm_region_hit(episode: VLNCEEpisodeEntry, raw_start_position, args: Args) -> Optional[float]:
+    import torch
+    from vlnce_baselines.models.etp_llm.navigation import llm_cached_cognitive_map_to_tensors
+    from vlnce_baselines.models.etp_prior_gt.map_utils import SIZE, map_origin_xz, world_to_map_cells
+
+    cache_id = f"R2R_{args.split}_{episode.episode_id}"
+    try:
+        cm = llm_cached_cognitive_map_to_tensors(
+            episode.scene_id, cache_id, "R2R", args.split,
+            metadata_schema="direction5", model_key=args.llm_model_key,
+        )
+    except FileNotFoundError:
+        return None
+    grid = cm["grid"].float()
+    origin = map_origin_xz(raw_start_position, cm["start_position"], args.meters_per_unit)
+    cells = world_to_map_cells(np.asarray(episode.ground_truth_trajectory, dtype=np.float64), origin)
+    index = torch.floor(cells).long()
+    inside = ((index >= 0) & (index < SIZE)).all(dim=-1)
+    if not bool(inside.any()):
+        return 0.0
+    regions = grid[27:37]
+    hits = regions[:, index[inside, 0], index[inside, 1]].amax(dim=0) > 0
+    return float(hits.sum()) / float(len(cells))
+
+
+def main(argv: Optional[Sequence[str]] = None) -> None:
+    args = Args(underscores_to_dashes=True).parse_args(argv)
+    extract_categories = None
+    if not args.no_categories:
+        from prior.grid_map._cognitive import extract_categories as _ec
+        extract_categories = _ec
+
+    features: Dict[str, dict] = {}
+    scenes: Dict[str, SceneSemanticBoxes] = {}
+    n_done = 0
+    for ep in VLNCEEpisodeEntry.iter_from("R2R", splits=[args.split]):
+        if args.limit and n_done >= args.limit:
+            break
+        n_done += 1
+        gt = ep.ground_truth_trajectory
+        f: dict = {
+            "scene": ep.scene_id,
+            "path_len_m": path_length(gt),
+            "n_gt_points": len(gt),
+            "n_spatial_words": len(SPATIAL_WORDS.findall(ep.instruction)),
+            "n_words": len(ep.instruction.split()),
+        }
+        scene = scenes.get(ep.scene_id)
+        if scene is None:
+            scene = scenes[ep.scene_id] = SceneSemanticBoxes.from_scene_id(ep.scene_id)
+        try:
+            level_idx, level, level_points = _first_touched_level_points(scene, gt)
+            f["level"] = level_idx
+            f["n_room_changes"], f["n_rooms"] = room_stats(level, level_points)
+        except Exception as exc:  # level selection can fail on odd scenes
+            level = level_points = None
+            f["level"] = None
+            f["n_room_changes"] = f["n_rooms"] = None
+            f["level_error"] = str(exc)[:120]
+        f["n_forks_graph"], f["n_forks3_graph"] = fork_stats(ep.scene_id, gt, args.snap_radius)
+        if extract_categories is not None:
+            objs, regs = extract_categories(ep.instruction)
+            f["n_landmarks"] = len(objs)
+            f["n_room_words"] = len(regs)
+            if level is not None:
+                f["n_landmark_instances"], f["n_decoys"] = landmark_stats(
+                    level, level_points, objs, args.decoy_radius
+                )
+            else:
+                f["n_landmark_instances"] = f["n_decoys"] = None
+        else:
+            f["n_landmarks"] = f["n_room_words"] = f["n_landmark_instances"] = f["n_decoys"] = None
+        f["llm_region_hit"] = None if args.no_llm else llm_region_hit(ep, ep.start_position, args)
+        features[str(ep.episode_id)] = f
+        if n_done % 200 == 0:
+            print(f"{n_done} episodes", flush=True)
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, "w") as fh:
+        json.dump(features, fh)
+    vals = list(features.values())
+    def q(key):
+        xs = [v[key] for v in vals if v.get(key) is not None and v.get(key) != -1]
+        return f"n={len(xs)} mean={np.mean(xs):.2f} p50={np.median(xs):.2f}" if xs else "n/a"
+    print(f"wrote {args.out}: {len(features)} episodes")
+    for key in ("path_len_m", "n_room_changes", "n_forks_graph", "n_forks3_graph",
+                "n_landmarks", "n_decoys", "n_spatial_words", "llm_region_hit"):
+        print(f"  {key:22s} {q(key)}")
+
+
+if __name__ == "__main__":
+    main()
