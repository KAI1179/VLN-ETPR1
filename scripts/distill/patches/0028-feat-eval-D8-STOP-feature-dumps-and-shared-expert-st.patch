+#!/usr/bin/env bash
+# One model inference at a time. Shared states first; no background jobs.
+set -euo pipefail
+ROOT=/home/xukai/code/ETP-R1-snapshot/ETP-R1
+PYTHON=/home/xukai/anaconda3/envs/etpr1-py38/bin/python
