+MODEL="$1"; SOURCE="$2"; shift 2
+DUMP_ROOT="${DUMP_ROOT:-$ROOT/data/logs/d8_dump}"
+DUMP_DIR="$DUMP_ROOT/$MODEL/$SOURCE"
+case "$SOURCE" in
