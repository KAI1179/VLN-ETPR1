From 92a4ae5d8412d39db27c7afe95d99d59de30fe09 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 08:07:16 +0000
Subject: [PATCH] Resume support for the fixed-tokenizer DAgger launcher

RESUME=1 sbatch scripts/submit/llm-grid-try5-fixedtok-dagger.sh continues the
run from its latest ckpt.iter*.pth (IL.load_from_ckpt True IL.is_requeue True
appended after DAGGER_ARGS via the new LLM_GRID_TRY5_FIXEDTOK_EXTRA_ARGS hook
in main_server.bash), taking pretrained_path from the run's config.yaml when
the env var is not set.
---
 run_r2r/main_server.bash                        |  5 ++++-
 scripts/submit/llm-grid-try5-fixedtok-dagger.sh | 14 ++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/run_r2r/main_server.bash b/run_r2r/main_server.bash
index 4a8cf4b..052bf9e 100644
--- a/run_r2r/main_server.bash
+++ b/run_r2r/main_server.bash
@@ -187,6 +187,9 @@ LLM_GRID_TRY5_GRPO_MODEL_ARGS="TRAINER_NAME GRPO-ETP-LLM
 # Override the step with LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT=... when submitting.
 LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT="${LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT:-pretrained/r2r_rxr_ce/llm_grid_try5_fixedtok/ckpts/model_step_500000.pt}"
 LLM_GRID_TRY5_FIXEDTOK_DAGGER_CKPT="${LLM_GRID_TRY5_FIXEDTOK_DAGGER_CKPT:-}"
+# Extra run.py overrides appended after DAGGER_ARGS (later keys win), e.g.
+# "IL.load_from_ckpt True IL.is_requeue True" to resume from the latest ckpt.
+LLM_GRID_TRY5_FIXEDTOK_EXTRA_ARGS="${LLM_GRID_TRY5_FIXEDTOK_EXTRA_ARGS:-}"
 LLM_GRID_TRY5_FIXEDTOK_MODEL_ARGS="TRAINER_NAME SS-ETP-LLM
       MODEL.policy_name LLMGridTry5Policy
       MODEL.MAP_ENCODER.enabled True
@@ -306,7 +309,7 @@ case $mode in
       llm_grid_try5_fixedtok_dagger)
       echo "###### LLM-Grid Try5 (fixed tokenizer pretraining) DAgger ######"
       [ -f "${LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT}" ] || { echo "missing ${LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT}" >&2; exit 2; }
-      launch "--exp_name release_r2r_llm_grid_try5_fixedtok_dagger --run-type dagger ${COMMON_ARGS} NUM_ENVIRONMENTS ${MAP_NUM_ENVS} ${LLM_GRID_TRY5_FIXEDTOK_MODEL_ARGS} ${DAGGER_ARGS}"
+      launch "--exp_name release_r2r_llm_grid_try5_fixedtok_dagger --run-type dagger ${COMMON_ARGS} NUM_ENVIRONMENTS ${MAP_NUM_ENVS} ${LLM_GRID_TRY5_FIXEDTOK_MODEL_ARGS} ${DAGGER_ARGS} ${LLM_GRID_TRY5_FIXEDTOK_EXTRA_ARGS}"
       ;;
       llm_grid_try5_fixedtok_eval_dagger)
       echo "###### LLM-Grid Try5 (fixed tokenizer pretraining) DAgger eval ######"
diff --git a/scripts/submit/llm-grid-try5-fixedtok-dagger.sh b/scripts/submit/llm-grid-try5-fixedtok-dagger.sh
index 656e89f..0e1fde6 100755
--- a/scripts/submit/llm-grid-try5-fixedtok-dagger.sh
+++ b/scripts/submit/llm-grid-try5-fixedtok-dagger.sh
@@ -9,4 +9,18 @@
 # The env's conda activate.d hooks read unset variables, so turn on nounset only afterwards.
 eval "$(conda shell.bash hook)" && conda activate etpr1-uv || { echo "conda activate etpr1-uv failed" >&2; exit 2; }
 set -euo pipefail
+# RESUME=1: continue the existing run from its latest ckpt.iter*.pth (weights,
+# optimizer, scheduler and iteration are restored; IL.iters stays 30000).
+# pretrained_path is then taken from the run's config.yaml unless given.
+RUN_DIR="data/logs/checkpoints/release_r2r_llm_grid_try5_fixedtok_dagger"
+if [[ "${RESUME:-0}" == "1" ]]; then
+    LATEST="$(ls -1 "${RUN_DIR}"/ckpt.iter*.pth 2>/dev/null | sed -E 's/.*ckpt\.iter([0-9]+)\.pth/\1 &/' | sort -n | tail -1 | cut -d' ' -f2 || true)"
+    [[ -n "${LATEST}" ]] || { echo "RESUME=1 but no ckpt.iter*.pth in ${RUN_DIR}" >&2; exit 2; }
+    if [[ -z "${LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT:-}" ]]; then
+        LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT="$(grep -E '^\s*pretrained_path:' "${RUN_DIR}/config.yaml" | head -1 | awk '{print $2}' | tr -d "'\"")"
+        export LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT
+    fi
+    export LLM_GRID_TRY5_FIXEDTOK_EXTRA_ARGS="IL.load_from_ckpt True IL.is_requeue True"
+    echo "Resuming from ${LATEST} (pretrained_path ${LLM_GRID_TRY5_FIXEDTOK_PRETRAINED_CKPT})"
+fi
 bash run_r2r/main_server.bash llm_grid_try5_fixedtok_dagger
-- 
2.43.0

